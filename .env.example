# Server Configuration
grapery_ENV=development
grapery_HTTP_PORT=8080
grapery_LOG_LEVEL=info
grapery_ALLOW_ORIGIN=http://localhost:5173

# Database Configuration
DB_DATABASE=grapery
DB_USERNAME=root
DB_PASSWORD=12345678
DB_ADDRESS=localhost

# Redis Configuration
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PING_INTERVAL=30

# JWT Configuration
JWT_SECRET=voyager2026

# Agent Access Token (parallel public): grapery 签发短期 token，客户端凭此直连 grapery-agent。
# 必须独立于 JWT_SECRET，并与 grapery-agent 的 AGENT_TOKEN_VERIFY_KEY 完全一致。
AGENT_TOKEN_SIGNING_KEY=
AGENT_TOKEN_TTL_SEC=300
AGENT_TOKEN_REPLAY_CACHE_ENABLED=false
AGENT_PUBLIC_PARALLEL_ENABLED=false
AGENT_EXEC_FRAGMENT_PANEL_ENABLED=false
GRAPERY_INTERNAL_API_KEY=

# Apple Push Notifications (APNs) — .p8 key in grapery/certs/ (see APNS_PRIVATE_KEY_PATH)
# Voyager iOS bundle: com.rankquantity.voyager
APNS_BUNDLE_ID=com.rankquantity.voyager
APNS_TEAM_ID=UZLNTVX73Y
APNS_KEY_ID=NLX828W4A6
APNS_PRIVATE_KEY_PATH=certs/AuthKey_NLX828W4A6.p8
# true = api.sandbox.push.apple.com (Xcode dev installs). false = production (TestFlight / App Store).
APNS_USE_SANDBOX=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here

# ========== VIPPay — Apple IAP (StoreKit 2; 仅 run-vippay / docker-compose.vippay 需要) ==========
# 生产值在 GitHub Actions Variables；本地请复制 env.vippay.example 为 vippay 部署目录 .env
# APPLE_BUNDLE_ID=com.rankquantity.voyager
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# WeChat Open Platform (VIPPay: mobile / web OAuth code → access_token)
# AppSecret 仅服务端；iOS 使用 Info.plist WeChatAppID + URL Scheme（勿写入客户端）。
# CI/CD: GitHub Repository Variables WECHAT_APP_ID、WECHAT_APP_SECRET（见 grapery/.github/workflows/vippay-ci.yml）
WECHAT_APP_ID=wx9f04b65294679871
WECHAT_APP_SECRET=your-wechat-app-secret-here

# Telemetry（本地默认关闭；生产环境通过 env 或 config yaml 开启）
# TELEMETRY_SLS_ENABLED=false
# TELEMETRY_PROMETHEUS_ENABLED=false
# TELEMETRY_PROMETHEUS_PUSH_GATEWAY=

# Aliyun SMS (phone OTP)
# Sign/template 已在代码中有默认值（上海秩量科技 / SMS_333971751）
# GitHub Variables: ALIYUN_SMS_ACCESS_ID / ALIYUN_SMS_ACCESS_SECRET
# 本地等效：ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_USE_DEFAULT_CREDENTIAL=1
# ALIYUN_SMS_REGION=cn-hangzhou
