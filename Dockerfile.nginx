FROM nginx:alpine

# 复制nginx配置文件
COPY nginx.conf /etc/nginx/nginx.conf

# 删除默认配置以避免冲突
RUN rm -f /etc/nginx/conf.d/default.conf

# 创建静态文件目录
RUN mkdir -p /usr/share/nginx/html

# 复制主页文件
COPY index.html /usr/share/nginx/html/

# 创建默认错误页面
RUN echo '<!DOCTYPE html><html><head><title>404 - 页面未找到</title></head><body><h1>404 - 页面未找到</h1><p>抱歉，您访问的页面不存在。</p></body></html>' > /usr/share/nginx/html/404.html

RUN echo '<!DOCTYPE html><html><head><title>500 - 服务器错误</title></head><body><h1>500 - 服务器错误</h1><p>抱歉，服务器出现了问题。</p></body></html>' > /usr/share/nginx/html/50x.html

# 设置权限
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# 暴露端口
EXPOSE 80 443

# 启动nginx
CMD ["nginx", "-g", "daemon off;"] 