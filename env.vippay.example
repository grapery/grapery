# ========== Grapery VIPPay Service Environment Variables ==========
# 复制此文件为 .env 并填入实际值
# cp env.vippay.example .env

# ========== Service Configuration ==========
VIPPAY_PORT=8081
SERVICE_NAME=vippay
IMAGE=grapery-vippay:dev

# ========== Database Configuration ==========
DB_DATABASE=grapery
DB_USERNAME=root
DB_PASSWORD=your-database-password
DB_ADDRESS=localhost:3306

# ========== JWT Configuration ==========
# 重要：生产环境必须使用强密钥 (生成命令: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY_HOURS=24

# ========== Apple IAP (StoreKit 2 / App Store Server API) ==========
# App Store Connect → Users and Access → Integrations → App Store Connect API
# CI/CD：GitHub Repository Variables（与 vippay-ci.yml 一致）
APPLE_BUNDLE_ID=com.rankquantity.voyager
APPLE_ISSUER_ID=your-issuer-id-from-app-store-connect
APPLE_KEY_ID=your-10-char-key-id
# .p8 全文（保留换行）；docker compose .env 可用：
# APPLE_PRIVATE_KEY<<EOF
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# EOF
APPLE_PRIVATE_KEY=your-app-store-connect-api-private-key-pem
# 可选：与生产不同的沙盒 Key（通常与上一组相同即可）
# APPLE_SANDBOX_BUNDLE_ID=
# APPLE_SANDBOX_ISSUER_ID=
# APPLE_SANDBOX_KEY_ID=
# APPLE_SANDBOX_PRIVATE_KEY=
# 仅本地 Xcode StoreKit Configuration（生产切勿开启）
# IAP_ALLOW_STOREKIT_LOCAL=true

# ========== OAuth Configuration ==========
# Apple Sign-In（与 IAP API Key 不同；可选）
# APPLE_TEAM_ID=YOUR_TEAM_ID
# APPLE_SIGNIN_KEY_ID=YOUR_SIGNIN_KEY_ID
# APPLE_SIGNIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google OAuth
# 重要：必须使用 Web/Server Client ID（不是 iOS 或 Android Client ID）
# 用途：验证 Google ID Token 的 audience
GOOGLE_CLIENT_ID=345805164843-pbd5oc8emnu03l1i0sdn7r19pmk10ajf.apps.googleusercontent.com

# WeChat Open Platform（移动应用登录 + 分享；AppSecret 仅服务端）
# iOS：Info.plist WeChatAppID / URL Scheme wx… + Universal Link https://www.rankquantity.xyz/wechat/
# CI/CD：GitHub Repository Variables WECHAT_APP_ID、WECHAT_APP_SECRET（见 grapery/.github/workflows/vippay-ci.yml）
WECHAT_APP_ID=wx9f04b65294679871
WECHAT_APP_SECRET=your-wechat-app-secret-here

# ========== Aliyun OSS Configuration ==========
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_SECRET_KEY=your-aliyun-secret-key
ALIYUN_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_BUCKET=grapery-dev

# ========== AI Configuration ==========
HUOSHAN_API_KEY=your-huoshan-api-key
HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
GEMINI_API_KEY=your-gemini-api-key

# ========== Telemetry Configuration (Optional) ==========
PROMETHEUS_ENABLED=false
TRACING_ENABLED=false

# ========== Aliyun SMS（OAuth 手机短信验证 send-sms-code）==========
# GitHub Variables: ALIYUN_SMS_ACCESS_ID / ALIYUN_SMS_ACCESS_SECRET
# ALIYUN_SMS_SIGN_NAME=短信签名审核通过的全称
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxx（模板变量名 code，与后端 JSON 一致）
# 本地/容器：ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET（与上两项二选一命名）
# ALIYUN_SMS_USE_DEFAULT_CREDENTIAL=1
# 可选：ALIYUN_SMS_REGION（默认 cn-hangzhou）、ALIYUN_SMS_ENDPOINT（默认 dysmsapi.aliyuncs.com）

# ========== 重要说明 ==========
# 1. 环境变量优先级高于配置文件 vippay.json
# 2. 敏感信息（密码、密钥）不应提交到版本控制
# 3. 生产环境必须设置强 JWT_SECRET
# 4. GOOGLE_CLIENT_ID 必须是 Web/Server Client ID
#
# 相关文档：
# - grapery/cmd/vippay/CONFIG.md
# - grapery/docs/iap_config_requirements.md
# - grapery/docs/oauth_config_requirements.md
# - grapery/docs/GOOGLE_OAUTH_CLIENT_IDS.md

